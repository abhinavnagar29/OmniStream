# PostgreSQL connection string (must have the pgvector extension available)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/omnistream"

# Redis connection string, used for caching, rate limiting, and the async
# analytics event pipeline (Redis Streams)
REDIS_URL="redis://localhost:6379"

# Secret used to sign JWTs -- generate with `openssl rand -hex 32` in real deployments
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"

PORT=5050
NODE_ENV=development

# Comma-separated list of allowed frontend origins for CORS, e.g.
# "https://omnistream.vercel.app". Leave unset to allow all origins (fine
# for local dev or a same-origin deploy where server.js serves the built
# frontend itself).
# CORS_ORIGIN=

# Rate limiting (Redis-backed, shared across instances -- see docs/architecture.md)
# RATE_LIMIT_MAX=120
# RATE_LIMIT_WINDOW_MS=60000

# Optional: real content ingestion (only used if you wire up scripts/ingest/*)
# TMDB_API_KEY=
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# NEWSAPI_KEY=

# --- Frontend build-time variable (Vite) ---
# Only needed for a SPLIT deploy (frontend and backend on different domains).
# Leave unset for a same-origin deploy -- the frontend defaults to calling
# its own origin's /api, which is correct when server.js serves the built
# frontend itself.
# VITE_API_BASE_URL=https://omnistream-api.onrender.com/api
