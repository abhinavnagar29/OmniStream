{
  "name": "cross-domain-recommendation-platform",
  "version": "1.0.0",
  "description": "A unified recommendation platform aggregating content across multiple domains",
  "main": "index.js",
  "scripts": {
    "dev": "node dev.js",
    "dev:frontend": "vite --port 3002 --strictPort",
    "dev:backend": "PORT=5050 node server.js",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server.js",
    "ingest": "node scripts/ingest/index.js",
    "db:migrate": "node scripts/db/migrate.js",
    "worker:analytics": "node scripts/worker/analyticsWorker.js",
    "eval": "python3 ml/evaluate.py",
    "test": "NODE_ENV=test jest --runInBand",
    "test:watch": "NODE_ENV=test jest --watch"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "autoprefixer": "^10.4.14",
    "axios": "^1.3.4",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.2",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.0",
    "fast-xml-parser": "^4.5.3",
    "helmet": "^8.1.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.263.1",
    "morgan": "^1.10.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "postcss": "^8.4.21",
    "rate-limit-redis": "^4.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^6.8.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "tailwindcss": "^3.2.7",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "@vitejs/plugin-react": "^3.1.0",
    "autocannon": "^8.0.0",
    "jest": "^30.0.5",
    "supertest": "^7.1.4",
    "vite": "^4.1.4"
  },
  "keywords": [
    "recommendation",
    "cross-domain",
    "content-aggregation",
    "personalization"
  ],
  "author": "Hackathon Team",
